{
  "name": "@oursay/web-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OurSay civic web app (Next.js App Router). Recreates the mobile wireframe's read model in full colour. Mock-backed frontend API today; swappable for /v1/public/... later.",
  "scripts": {
    "dev": "next dev -p 3000 --webpack",
    "up": "node scripts/stack-up.mjs",
    "down": "npm run down -w @oursay/api",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dicebear/core": "^10.3.0",
    "@dicebear/styles": "^10.2.0",
    "@oursay/content-limits": "*",
    "@oursay/encode": "*",
    "@oursay/identity": "*",
    "@oursay/public-record": "*",
    "@oursay/slugs": "*",
    "@simplewebauthn/browser": "^13.1.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.22.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.4.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.9"
  }
}
