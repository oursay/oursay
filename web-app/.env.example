# @oursay/web-app — copied to `.env.local` (gitignored) for overrides.
# Repo-root `.env` is also loaded by next.config.ts (same as @oursay/api).

# Live backend (default is mock — no API, no real OTP/passkey).
# NEXT_PUBLIC_MOCK_ONLY=0

# Override API origin for /v1 rewrites (default http://localhost:6173).
# OURSAY_API_URL=http://localhost:8080
# --- Web app (Next.js on :3000) ---
# Live mode: proxy /v1 to @oursay/api. Unset / 1 / true = mock corpus (default).
NEXT_PUBLIC_MOCK_ONLY=0
# Non-affiliation / demo banner above the compose FAB. Unset / 1 / true = show (default).
# When both demo + donation banners are on, demo wins and the console warns once.
# NEXT_PUBLIC_SHOW_DEMO_BANNER=false
# Donation surfaces (all default off). Provider is required — unset does not
# assume github. Pick a modal provider, then set its config.
# NEXT_PUBLIC_DONATION_MODAL_PROVIDER=github
# NEXT_PUBLIC_GITHUB_SPONSORS_URL=https://github.com/sponsors/your-org
# NEXT_PUBLIC_DONATION_MODAL_PROVIDER=etransfer
# NEXT_PUBLIC_ETRANSFER_EMAIL=donate@example.ca
# NEXT_PUBLIC_SHOW_DONATION_BANNER=true
# NEXT_PUBLIC_SHOW_DONATION_MODAL_PUBLIC=true
# NEXT_PUBLIC_SHOW_DONATION_MODAL_KYC=true