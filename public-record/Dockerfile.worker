# Settlement worker image — runs `npm run worker -w @oursay/public-record` against the
# compose-network Postgres + immudb. Build context is the monorepo root.
FROM node:22-bookworm-slim

WORKDIR /repo

COPY package.json package-lock.json ./
COPY public-record ./public-record
COPY geo ./geo
COPY slugs ./slugs
COPY encode ./encode
COPY scripts ./scripts
# Remaining workspaces are listed in the root package.json; stub their package.json so
# `npm ci` can link the workspace graph without copying the whole monorepo.
COPY api/package.json ./api/
COPY identity/package.json ./identity/
COPY jurisdiction-data/package.json ./jurisdiction-data/
COPY web-app/package.json ./web-app/
COPY site/package.json ./site/
COPY evm-anchor/package.json ./evm-anchor/

RUN npm ci

WORKDIR /repo
CMD ["npm", "run", "worker", "-w", "@oursay/public-record"]
