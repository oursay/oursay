# OurSay — production (VPS) environment template
#
# Copy to `.env` at the repo root on the VPS (gitignored) and fill in.
# Used by `docker compose -f docker-compose.prod.yml` / `npm run prod:up`.
#
# Workspace-specific overrides may still live in api/.env and public-record/.env;
# compose loads those as optional env_file entries for api + worker.
#
# Full runbook: docs/VPS-PRODUCTION-STACK.md

NODE_ENV=production

# --- Domains (Traefik Host rules) ---
# site:    ${BASE_DOMAIN} + www.${BASE_DOMAIN}
# web-app: demo.${BASE_DOMAIN} + app.${BASE_DOMAIN}
# api:     api.${BASE_DOMAIN}
BASE_DOMAIN=oursay.ca

# Let's Encrypt ACME account email (required). Traefik will not start without it.
TRAEFIK_ACME_EMAIL=

# --- Required secrets (generate once; never commit) ---
# SESSION_SECRET — server pepper for OTP + session token hashes
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PLATFORM_BINDING_PRIVKEY — P-256 hex private key for thread registration bindings
#   node -e "import('@noble/curves/p256').then(({p256})=>import('@noble/hashes/utils').then(({bytesToHex})=>console.log(bytesToHex(p256.utils.randomPrivateKey()))))"
PLATFORM_BINDING_PRIVKEY=

# LEDGER_ID — one UUID per immudb instance; must match api + worker + ledger_meta
#   node -e "console.log(require('crypto').randomUUID())"
LEDGER_ID=

# --- WebAuthn (browser origins for demo + app) ---
WEBAUTHN_RP_ID=oursay.ca
WEBAUTHN_RP_NAME=OurSay
WEBAUTHN_ORIGIN=https://demo.oursay.ca,https://app.oursay.ca

# --- Civic defaults ---
CHAIN_ID=ab-ca-gov
JURISDICTION_ID=ab-ca-gov
WORKER_CHAIN_IDS=oursay-global,ab-ca-gov

# --- Postgres (compose-network service `postgres`; not published to the host) ---
PGUSER=oursay
PGPASSWORD=oursay
PGDATABASE=oursay_public_record

# --- Mailer (see docs/POSTMARK-OTP-SETUP.md) ---
MAILER_FROM=OurSay <no-reply@oursay.ca>
MAILER_OTP_USE_POSTMARK=true
MAILER_REGISTRATION_VENDORS=postmark
MAILER_RECOVERY_VENDORS=postmark
MAILER_LOGIN_VENDORS=postmark
POSTMARK_SERVER_TOKEN=

# --- KYC (see docs/DIDIT-KYC-SETUP.md) — stub until production Didit is ready ---
KYC_PROVIDER=stub
# DIDIT_API_KEY=
# DIDIT_WEBHOOK_SECRET=
# DIDIT_WORKFLOW_ID=
# DIDIT_WORKFLOW_POA=
# DIDIT_WORKFLOW_RECOVER=
# DIDIT_CALLBACK_URL=https://demo.oursay.ca/profile/self

# --- Web-app (Next.js) — NEXT_PUBLIC_* are baked at image build time ---
# Rebuild web-app after changing these: docker compose … build web-app && up -d
NEXT_PUBLIC_SHOW_DEMO_BANNER=false
NEXT_PUBLIC_GITHUB_SPONSORS_URL=https://github.com/sponsors/oursay
NEXT_PUBLIC_SHOW_DONATION_MODAL_PUBLIC=true
NEXT_PUBLIC_SHOW_DONATION_MODAL_KYC=true
# NEXT_PUBLIC_SHOW_DONATION_BANNER=true

# --- Optional: allow `npm run prod:down` while NODE_ENV=production (volumes kept) ---
# OURSAY_ALLOW_PROD_DOWN=1
