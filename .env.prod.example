# Production-local stack ports — copy to `.env.prod` (gitignored) or merge into a
# deployment `.env` when pointing apps at `docker-compose.prod.yml`.
#
# Start the prod stack:
#   npm run db:prod:up -w @oursay/public-record
#
# Port map (host):
#   dev  — PG 5442, immudb 5443, console 8082  (docker-compose.dev.yml)
#   test — PG 5444, immudb 5445, console 8083  (docker-compose.test.yml)
#   prod — PG 5446, immudb 5447, console 8084  (docker-compose.prod.yml)

# --- Postgres (oursay-public-record-pg on :5446) ---
PGHOST=127.0.0.1
PGPORT=5446
PGUSER=oursay
PGPASSWORD=oursay
PGDATABASE=oursay_public_record

# --- immudb (oursay-public-record-immudb on :5447) ---
IMMUDB_PG_HOST=127.0.0.1
IMMUDB_PG_PORT=5447
IMMUDB_PG_USER=immudb
IMMUDB_PG_PASSWORD=immudb
IMMUDB_PG_DATABASE=defaultdb
