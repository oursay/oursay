# Integration-test environment — copy to `.env.test` (gitignored) at the repo root.
# Mocha loads this via `scripts/load-test-env.ts` with override:true BEFORE package config,
# so these ports win even when api/.env points at the dev stack (5442).
#
# Start the test stack first:
#   npm run db:test:up -w @oursay/public-record
#
# Port map (host):
#   dev  — PG 5442, immudb 5443, console 8082  (docker-compose.dev.yml)
#   test — PG 5444, immudb 5445, console 8083  (docker-compose.test.yml)
#   prod — PG 5446, immudb 5447, console 8084  (docker-compose.prod.yml)

# --- Postgres (oursay-test-public-record-pg on :5444) ---
PGHOST=127.0.0.1
PGPORT=5444
PGUSER=oursay
PGPASSWORD=oursay
PGDATABASE=oursay_test

# --- immudb test stack (oursay-test-public-record-immudb on :5445) ---
IMMUDB_PG_HOST=127.0.0.1
IMMUDB_PG_PORT=5445
IMMUDB_PG_USER=immudb
IMMUDB_PG_PASSWORD=immudb
IMMUDB_PG_DATABASE=defaultdb

# Ephemeral chain id per test run (matches public-record test defaults).
CHAIN_ID=oursay-test
