{
  "name": "@oursay/evm-anchor",
  "version": "0.0.0",
  "private": true,
  "description": "EVM anchoring: Hardhat contracts and tests for publishing public-record Merkle roots on-chain.",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:mocha": "hardhat test mocha",
    "node": "hardhat node --hostname 0.0.0.0 --port 8545",
    "deploy:local": "hardhat compile && tsx scripts/deploy-local.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.14",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "chai": "^5.3.3",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.9.1",
    "mocha": "^11.7.6",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
