# Hardhat JSON-RPC node + auto-deploy for local EVM anchoring.
# Build context: monorepo root.
FROM node:22-bookworm-slim

WORKDIR /repo

COPY package.json package-lock.json ./
COPY evm-anchor ./evm-anchor
COPY api/package.json ./api/
COPY identity/package.json ./identity/
COPY jurisdiction-data/package.json ./jurisdiction-data/
COPY web-app/package.json ./web-app/
COPY site/package.json ./site/
COPY public-record/package.json ./public-record/
COPY geo/package.json ./geo/
COPY slugs/package.json ./slugs/
COPY encode/package.json ./encode/
COPY content-limits/package.json ./content-limits/

RUN npm ci
RUN npm run compile -w @oursay/evm-anchor
RUN chmod +x /repo/evm-anchor/scripts/docker-entrypoint.sh

EXPOSE 8545
WORKDIR /repo
ENTRYPOINT ["/repo/evm-anchor/scripts/docker-entrypoint.sh"]
